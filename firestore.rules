rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCalendarAdmin() {
      return request.auth != null
        && request.auth.uid == 'qTwqAVxs8NcVllFFUmA37m4rP5d2';
    }

    match /calendars/{calendarId} {
      allow read: if true;
      allow create: if isCalendarAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 70;
      allow update: if isCalendarAdmin()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 70;
      allow delete: if false;

      match /events/{eventId} {
        allow read: if true;
        allow create: if isCalendarAdmin()
          && get(/databases/$(database)/documents/calendars/$(calendarId)).data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.date is string;
        allow update: if isCalendarAdmin()
          && get(/databases/$(database)/documents/calendars/$(calendarId)).data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.date is string;
        allow delete: if isCalendarAdmin()
          && get(/databases/$(database)/documents/calendars/$(calendarId)).data.createdBy == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
